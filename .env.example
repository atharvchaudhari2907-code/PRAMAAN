# ==============================================================================
# BIS AI ASSISTANT / BIS ONE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env (for backend configuration)
# DO NOT commit real production secrets to public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM CONFIGURATION (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for PDF extraction, multimodal understanding, and LLM reasoning)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Names (Configurable — do not hardcode in application code)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE (Pinecone RAG)
# ------------------------------------------------------------------------------
# Pinecone Vector Store Configuration (For RAG knowledge-base semantic search)
# Get your credentials from: https://www.pinecone.io/
# Note: Built-in resilient in-memory fallback is automatically used if key is not configured.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=bis-standards-index
PINECONE_ENVIRONMENT=us-east-1
PINECONE_METRIC=cosine

# ------------------------------------------------------------------------------
# 3. RELATIONAL DATABASE
# ------------------------------------------------------------------------------
# Default uses SQLite for zero-config local run; switch to PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./bis_assistant.db
# PostgreSQL Production Example: postgresql+asyncpg://postgres:password@localhost:5432/bis_assistant

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (Email + Password)
# ------------------------------------------------------------------------------
# Secure random string used for signing access & refresh tokens (e.g. generate via: openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend application base URL (used for building verification and reset links in emails)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL NOTIFICATIONS (Verification & Password Reset)
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER: "console" (logs verification & reset links to terminal for zero-setup dev)
#                 "smtp" (sends live emails via standard SMTP server e.g. SendGrid, Mailgun, AWS SES, Gmail)
EMAIL_PROVIDER=console
EMAILS_FROM_EMAIL=noreply@bis-assistant.gov.in
EMAILS_FROM_NAME=BIS AI Assistant

# SMTP Configuration (Required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key
SMTP_TLS=True

# ------------------------------------------------------------------------------
# 6. FILE STORAGE & CONTENT-ADDRESSED LEDGER
# ------------------------------------------------------------------------------
STORAGE_PATH=./backend/uploads

# ------------------------------------------------------------------------------
# 7. DECENTRALIZED IPFS PINNING (Optional)
# ------------------------------------------------------------------------------
# Pinata IPFS Gateway JWT or API key for pinning certification dossiers to IPFS.
# If unset, the built-in Content-Addressed IPFS provider stores files deterministically in uploads/ipfs.
PINATA_JWT=
PINATA_API_KEY=

# ------------------------------------------------------------------------------
# 8. BLOCKCHAIN / CRYPTOGRAPHIC TRUST LEDGER (Optional)
# ------------------------------------------------------------------------------
# Ethereum / Polygon / Ganache RPC URL for anchoring certificate SHA-256 hashes on-chain.
# If unset, the built-in Local Cryptographic Ledger performs full SHA-256 block anchoring with genesis linking.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
